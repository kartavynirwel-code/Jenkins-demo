pipeline {

    agent any

    environment {
        APP_NAME   = 'springboot-demo'
        APP_JAR    = 'springboot-demo/target/springboot-demo.jar'
        DEPLOY_DIR = '/opt/springboot-demo'
        EC2_USER   = 'ec2-user'          // ubuntu ke liye 'ubuntu' karo
        EC2_HOST   = '23.22.205.174'     // apna EC2 IP
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        stage('Build & Test') {
            steps {
                dir('springboot-demo') {
                    sh 'mvn clean package'
                }
            }
            post {
                always {
                    junit testResults: 'springboot-demo/target/surefire-reports/**/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${APP_JAR}", fingerprint: true
            }
        }

        stage('Deploy to EC2') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'EC2_SSH_KEY',
                    keyFileVariable: 'PEM'
                )]) {
                    // 1. Deploy folder banana
                    sh "ssh -o StrictHostKeyChecking=no -i $PEM ${EC2_USER}@${EC2_HOST} 'mkdir -p ${DEPLOY_DIR}'"

                    // 2. JAR copy karo
                    sh "scp -o StrictHostKeyChecking=no -i $PEM ${APP_JAR} ${EC2_USER}@${EC2_HOST}:${DEPLOY_DIR}/${APP_NAME}.jar"

                    // 3. Old app band karo, naya start karo
                    sh """
                        ssh -o StrictHostKeyChecking=no -i $PEM ${EC2_USER}@${EC2_HOST} '
                            PID=\$(pgrep -f "${APP_NAME}.jar" || true)
                            [ -n "\$PID" ] && echo "Stopping \$PID" && kill \$PID && sleep 3

                            nohup java -jar ${DEPLOY_DIR}/${APP_NAME}.jar \
                                > ${DEPLOY_DIR}/app.log 2>&1 &

                            sleep 10
                            curl -sf http://localhost:8080/actuator/health \
                                && echo "=== Health check PASSED ===" \
                                || echo "=== Health check FAILED ==="
                        '
                    """
                }
            }
        }
    }

    post {
        success { echo "App live at http://${EC2_HOST}:8080/api/hello" }
        failure { echo "Pipeline FAILED - check logs" }
    }
}
