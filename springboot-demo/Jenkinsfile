pipeline {

    agent any

    environment {
        APP_NAME   = 'springboot-demo'
        APP_JAR    = 'springboot-demo/target/springboot-demo.jar'
        DEPLOY_DIR = '/home/ubuntu/springboot-demo'
        EC2_USER   = 'ubuntu'
        EC2_HOST   = '23.22.205.174'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        stage('Build & Test') {
            steps {
                dir('springboot-demo') {
                    sh 'mvn clean package'
                }
            }

            post {
                always {
                    junit testResults: 'springboot-demo/target/surefire-reports/**/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${APP_JAR}", fingerprint: true
            }
        }

        stage('Deploy to EC2') {

            steps {

                withCredentials([sshUserPrivateKey(
                    credentialsId: 'ec2-key',
                    keyFileVariable: 'PEM'
                )]) {

                    // Create deploy directory
                    sh """
                        ssh -o StrictHostKeyChecking=no \
                        -i \$PEM \
                        ${EC2_USER}@${EC2_HOST} \
                        'mkdir -p ${DEPLOY_DIR}'
                    """

                    // Copy jar to EC2
                    sh """
                        scp -o StrictHostKeyChecking=no \
                        -i \$PEM \
                        ${APP_JAR} \
                        ${EC2_USER}@${EC2_HOST}:${DEPLOY_DIR}/${APP_NAME}.jar
                    """

                    // Stop old app and start new app
                    sh """
                        ssh -o StrictHostKeyChecking=no \
                        -i \$PEM \
                        ${EC2_USER}@${EC2_HOST} '

                            pkill -f "springboot-demo.jar" 2>/dev/null || true
                            sleep 5

                            nohup java -jar ${DEPLOY_DIR}/${APP_NAME}.jar \
                            > ${DEPLOY_DIR}/app.log 2>&1 &

                            echo "Application deployed successfully"
                        '
                    """
                }
            }
        }
    }

    post {

        success {
            echo "App live at http://${EC2_HOST}:8080/api/hello"
        }

        failure {
            echo "Pipeline FAILED - check logs"
        }
    }
}
