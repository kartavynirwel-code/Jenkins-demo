pipeline {

    agent any

    environment {
        APP_NAME   = 'springboot-demo'
        APP_JAR    = 'springboot-demo/target/springboot-demo.jar'
        DEPLOY_DIR = '/opt/springboot-demo'
        EC2_USER   = 'ec2-user'          // ubuntu ke liye 'ubuntu' karo
        EC2_HOST   = '23.22.205.174'     // apna EC2 IP
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        stage('Build & Test') {
            steps {
                dir('springboot-demo') {
                    sh 'mvn clean package'
                }
            }
            post {
                always {
                    junit testResults: 'springboot-demo/target/surefire-reports/**/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${APP_JAR}", fingerprint: true
            }
        }

        stage('Deploy to EC2') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'MIIEpAIBAAKCAQEAlNjOq/j9bbpEC2ExlD4mWyzCqw9qzMIE5ETO9dcNcvu7NKqx
